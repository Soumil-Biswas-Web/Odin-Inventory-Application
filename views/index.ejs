<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/main.css" />
    <title>Odin-Inventory-Application</title>
</head>
<body>
    <%- include('components/header.ejs'); -%>
    <div class="Table">
        <% for (let trainer of trainers) {%>
            <div class="trainer-bloc">
                <h2><%= trainer.trainer_name %></h2>
                <div class="row">
                    <p><%= trainer.slot1 %></p>
                    <p><%= trainer.slot2 %></p>
                    <p><%= trainer.slot3 %></p>
                    <p><%= trainer.slot4 %></p>
                    <p><%= trainer.slot5 %></p>
                    <p><%= trainer.slot6 %></p>
                    <button onclick="window.location.href='/edit/<%= trainer.trainer_id %>'">Edit</button>
                    <button class="deleteButton" onclick="openModalWindow('<%= trainer.trainer_id%>')">Delete</button>
                </div>
            </div>
        <% } %>
    </div>

    <div id="modalWindow">
        <div class="box">
            Are you sure you want to delete this item?
            <div>
                <button
                    onclick=deleteItem()
                >Yes</button>
                <button
                    onclick=closeModalWindow()
                >No</button>
            </div>
        </div>
    </div>
    <%- include('components/footer.ejs'); -%>

    <script>
        let selectedId = 0;

        const openModalWindow = (id) => {
            document.querySelector("#modalWindow").style.display = "flex";
            selectedId = id;
        }

        const closeModalWindow = () => {
            document.querySelector("#modalWindow").style.display = "none";
        }

        const deleteItem = async() => {
            const response = await fetch(`/delete/${selectedId}`, { method: "DELETE" });

            if (response.ok) {
                alert("Trainer deleted successfully!");
                window.location.reload(); // Reload the page to reflect deletion
            } else {
                const errorData = await response.json();
                alert("Error deleting trainer: " + errorData.error);
            }

            closeModalWindow();
        }
    </script>
</body>
</html>